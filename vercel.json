{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/data/approved.json",
      "destination": "/api/user-art"
    },
    {
      "source": "/_va/:match*",
      "destination": "https://pixreveal.com/_vercel/insights/:match*"
    },
    {
      "source": "/_vs/:match*",
      "destination": "https://pixreveal.com/_vercel/speed-insights/:match*"
    },
    {
      "source": "/((?!api|@|.*\\..*|(?:blog|free-jackbox-alternative|free-skribbl-and-gartic-alternative|free-pixel-guessr-alternative|picture-reveal-game|phone-controller-party-game|friday-afterwork-game)(?:/|$)).*)",
      "destination": "/"
    }
  ],
  "headers": [],
  "crons": [
    {
      "path": "/api/cron-daily",
      "schedule": "0 7 * * *"
    }
  ]
}
